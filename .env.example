# Telegram Bot API Configuration for ZINACHI_NAM.UZ
# Create a bot with @BotFather on Telegram to get your token:
TELEGRAM_BOT_TOKEN="your_bot_token_here"

# Administrator chat ID or channel ID where orders will be delivered.
# To get your chat ID, message @userinfobot or your created bot and check updates:
# Default administrator: @ergashexsss7o2
TELEGRAM_ADMIN_CHAT_ID="your_telegram_chat_id_here"

# GEMINI_API_KEY: Optional AI assistant / translation features
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"
